# EmailJS credentials
# Dapatkan dari: https://dashboard.emailjs.com
#
# 1. Daftar/login di https://emailjs.com
# 2. Add Email Service → pilih Gmail → connect akun irmairyani@gmail.com
#    → copy SERVICE ID ke NEXT_PUBLIC_EMAILJS_SERVICE_ID
# 3. Email Templates → Create New Template
#    → copy TEMPLATE ID ke NEXT_PUBLIC_EMAILJS_TEMPLATE_ID
# 4. Account → API Keys → copy Public Key ke NEXT_PUBLIC_EMAILJS_PUBLIC_KEY

NEXT_PUBLIC_EMAILJS_SERVICE_ID=your_service_id
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=your_template_id
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=your_public_key
