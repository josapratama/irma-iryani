# ─── Backend API (dipakai browser) ────────────────────────────────────────────
# URL lengkap backend termasuk /api — dipakai langsung oleh lib/api.ts di browser
# Local : http://localhost:3001/api
# Prod  : https://irma.josapratama.cloud/api
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# ─── Backend Internal URL (opsional, dipakai Next.js rewrites) ────────────────
# URL backend tanpa /api — hanya dipakai Next.js server untuk proxy rewrites
# Isi ini jika ingin request browser cukup ke /api/* (relative) dan
# Next.js yang forward ke backend (berguna di production/staging)
# Jika tidak diisi, rewrites tidak aktif dan lib/api.ts fetch langsung ke backend
# BACKEND_INTERNAL_URL=http://localhost:3001

# ─── EmailJS (fallback jika backend tidak tersedia) ───────────────────────────
# Jika NEXT_PUBLIC_API_URL sudah dikonfigurasi, EmailJS tidak wajib diisi
NEXT_PUBLIC_EMAILJS_SERVICE_ID=your_service_id
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=your_template_id
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=your_public_key
