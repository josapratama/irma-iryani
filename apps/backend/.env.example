# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3001

# ─── MongoDB ──────────────────────────────────────────────────────────────────
# Local:   mongodb://localhost:27017/irma_portfolio
# Atlas:   mongodb+srv://<user>:<password>@cluster.mongodb.net/irma_portfolio
MONGODB_URI=mongodb://localhost:27017/irma_portfolio

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_EXPIRES_IN=7d

# ─── Admin (tidak dipakai langsung — admin dibuat via POST /api/auth/setup) ───
# Variabel ini ada di env.ts tapi belum digunakan secara aktif.
# Admin pertama dibuat via endpoint /api/auth/setup dengan email + password.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=

# ─── SMTP (Email) ─────────────────────────────────────────────────────────────
# Gmail: gunakan App Password (bukan password biasa)
# Aktifkan 2FA → https://myaccount.google.com/apppasswords → buat App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM=your-email@gmail.com
SMTP_TO=irma.iryani@email.com

# ─── Frontend ─────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ─── Environment ──────────────────────────────────────────────────────────────
NODE_ENV=development
